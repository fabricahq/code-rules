---
/** @fileoverview Renders an illustrative session as a complete transcript; the parent player progressively reveals its messages and tool output. */
import CodeSample from './CodeSample.astro';
/** One agent message followed by a file read, edit, or command result. */
interface Step {
  title: string;
  kind: string;
  file: string;
  note: string;
  code: string;
  lang: 'ts' | 'md' | 'diff' | 'text';
}
/** A named transcript with real text available even when animation is disabled. */
interface Props { title: string; id: string; task: string; steps: Step[]; selected?: boolean }
const { title, id, task, steps, selected = false } = Astro.props;
---
<section id={`session-${id}`} role="tabpanel" aria-labelledby={`tab-${id}`} hidden={!selected}>
  <div class="min-h-[27rem] py-4 px-[1.4rem] max-sm:min-h-[29rem] max-sm:py-[1.1rem] max-sm:px-[.85rem]" role="region" aria-label={`${title} transcript`} data-transcript>
    <div class="flex justify-end mb-5" data-user-message><p class="m-0 max-w-[85%] rounded-2xl px-4 py-2.5 bg-[color-mix(in_srgb,var(--session-user)_10%,var(--session-surface))] font-sans text-[.9rem] leading-[1.7] text-left text-(--session-text) [overflow-wrap:anywhere] max-sm:text-[.85rem]"><span class="sr-only">You: </span>{task}</p></div>
    {steps.map(step => <div class="mb-[.65rem] last:mb-0" data-event data-title={step.title}>
      <div class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-[.6rem]"><span class="text-(--session-agent) text-[1.15rem] leading-[1.2]" aria-hidden="true">✳︎</span><div><p class="m-0 font-sans text-[.9rem] leading-[1.7] text-(--session-text) [overflow-wrap:anywhere] max-sm:text-[.85rem]" data-note>{step.note}</p></div></div>
      <div class="tool-call mt-[.4rem] ml-[1.85rem] bg-transparent border border-(--session-border) rounded-lg overflow-hidden [--sample-font-size:.76rem] [--sample-padding:.5rem_.85rem] max-sm:ml-0 max-sm:[--sample-font-size:.7rem] max-sm:[--sample-padding:.5rem_.7rem]" data-tool data-kind={step.kind}>
        <div class="flex items-baseline gap-[.6rem] py-[.35rem] px-[.85rem] border-b border-(--session-border) font-mono text-[.67rem] leading-[1.6] max-sm:px-[.7rem] max-sm:gap-[.4rem] max-sm:text-[.6rem]"><span class="text-(--session-text-muted) shrink-0" aria-hidden="true">{step.kind === 'FAIL' ? '!' : step.kind === 'TEST' ? '✓' : '↳'}</span><span class="text-(--session-text-muted) shrink-0">{step.kind === 'RULE' ? 'Read file' : step.kind === 'FAIL' || step.kind === 'TEST' ? 'Run' : step.kind === 'PATCH' ? 'Apply patch' : step.kind === 'EDIT' ? 'Edit' : 'Read'}:</span><span class="text-(--session-text-muted) [overflow-wrap:anywhere] min-w-0">{step.file}</span><span class="tool-state ml-auto text-(--session-text-muted) text-[.6rem] max-sm:hidden" data-tool-state>done</span></div>
        <CodeSample code={step.code} lang={step.lang} label={step.file} tone="terminal" />
      </div>
    </div>)}
  </div>
</section>
<style>
  [hidden] { display: none !important; }
  .tool-state[data-running]::after { content: '…'; }
  [data-kind='FAIL'] .tool-state { color: var(--session-error); }
  [data-typing]::after { content: ''; display: inline-block; width: .45rem; height: .9em; margin-left: .2rem; background: var(--session-agent); vertical-align: -.08em; }
  .tool-call :global(.code-sample) { background: var(--session-surface-subtle); }
  .tool-call :global(code) { display: grid; }
  .tool-call :global(.line[hidden]) { display: none; }
  .tool-call :global(.line.added) { color: var(--session-diff-added); background: color-mix(in srgb, var(--session-diff-added) 10%, transparent); }
  .tool-call :global(.line.removed) { color: var(--session-diff-removed); background: color-mix(in srgb, var(--session-diff-removed) 8%, transparent); }
  .tool-call[data-kind='FAIL'] :global(pre.astro-code) { color: var(--session-error) !important; }
  .tool-call[data-kind='TEST'] :global(pre.astro-code) { color: var(--session-success) !important; }

</style>
