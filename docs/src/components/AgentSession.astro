---
/** @fileoverview Renders an illustrative session as a complete transcript; the parent player progressively reveals its messages and tool output. */
import CodeSample from './CodeSample.astro';
/** One agent message followed by a file read, edit, or command result. */
interface Step {
  title: string;
  kind: string;
  file: string;
  note: string;
  code: string;
  lang: 'ts' | 'md' | 'diff' | 'text';
}
/** A named transcript with real text available even when animation is disabled. */
interface Props { title: string; id: string; task: string; steps: Step[]; selected?: boolean }
const { title, id, task, steps, selected = false } = Astro.props;
---
<section id={`session-${id}`} role="tabpanel" aria-labelledby={`tab-${id}`} hidden={!selected}>
  <div class="transcript" role="region" aria-label={`${title} transcript`} data-transcript>
    <div class="prompt"><span class="prompt-symbol" aria-hidden="true">❯</span><div><p>{task}</p></div></div>
    {steps.map(step => <div class="event" data-event data-title={step.title}>
      <div class="agent-message"><span class="agent-symbol" aria-hidden="true">✳︎</span><div><p data-note>{step.note}</p></div></div>
      <div class="tool-call" data-tool data-kind={step.kind}>
        <div class="tool-heading"><span class="tool-icon" aria-hidden="true">{step.kind === 'FAIL' ? '!' : step.kind === 'TEST' ? '✓' : '↳'}</span><span class="tool-kind">{step.kind === 'RULE' ? 'Read rule' : step.kind === 'FAIL' || step.kind === 'TEST' ? 'Run' : step.kind === 'PATCH' ? 'Apply patch' : step.kind === 'EDIT' ? 'Edit' : 'Read'}:</span><span class="tool-file">{step.file}</span><span class="tool-state" data-tool-state>done</span></div>
        <CodeSample code={step.code} lang={step.lang} label={step.file} tone="terminal" />
      </div>
    </div>)}
  </div>
</section>
<style>
  [hidden] { display: none !important; }
  .transcript { min-height: 27rem; padding: 1rem 1.4rem; }
  .prompt, .agent-message { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: .6rem; }
  .prompt { padding-bottom: .75rem; margin-bottom: .85rem; border-bottom: 1px solid var(--demo-border); }
  .prompt-symbol { color: var(--demo-blue); font-weight: 700; }
  .agent-symbol { color: var(--demo-purple); font-size: 1.15rem; line-height: 1.2; }
  p { margin: 0; font: .9rem/1.7 var(--sl-font); color: var(--demo-ink); overflow-wrap: anywhere; }
  .event { margin-bottom: .65rem; }
  .event:last-child { margin-bottom: 0; }
  .tool-call { margin: .4rem 0 0 1.85rem; background: transparent; border: 1px solid var(--demo-border); border-radius: 8px; overflow: hidden; --sample-size: .76rem; --sample-padding: .5rem .85rem; }
  .tool-heading { display: flex; align-items: baseline; gap: .6rem; padding: .35rem .85rem; border-bottom: 1px solid var(--demo-border); font: .67rem/1.6 var(--cr-font-mono); }
  .tool-icon, .tool-kind { color: var(--demo-muted); flex-shrink: 0; }
  .tool-file { color: var(--demo-muted); overflow-wrap: anywhere; min-width: 0; }
  .tool-state { margin-left: auto; color: var(--demo-muted); font-size: .6rem; }
  .tool-state[data-running]::after { content: '…'; }
  [data-kind='FAIL'] .tool-state { color: var(--demo-red); }
  [data-typing]::after { content: ''; display: inline-block; width: .45rem; height: .9em; margin-left: .2rem; background: var(--demo-purple); vertical-align: -.08em; }
  .tool-call :global(.code-sample) { background: var(--demo-tool); }
  .tool-call :global(code) { display: grid; }
  .tool-call :global(.line[hidden]) { display: none; }
  .tool-call :global(.line.added) { color: var(--demo-green); background: color-mix(in srgb, var(--demo-green) 10%, transparent); }
  .tool-call :global(.line.removed) { color: var(--demo-red); background: color-mix(in srgb, var(--demo-red) 8%, transparent); }
  .tool-call[data-kind='FAIL'] :global(pre.astro-code) { color: var(--demo-red) !important; }
  .tool-call[data-kind='TEST'] :global(pre.astro-code) { color: var(--demo-green) !important; }
  @media (max-width: 540px) {
    .transcript { min-height: 29rem; padding: 1.1rem .85rem; }
    .tool-call { margin-left: 0; --sample-size: .7rem; --sample-padding: .5rem .7rem; }
    p { font-size: .85rem; }
    .tool-heading { padding: .35rem .7rem; gap: .4rem; font-size: .6rem; }
    .tool-state { display: none; }
  }
  @media (max-width: 360px) {
    .transcript { min-height: 34rem; }
  }
</style>
