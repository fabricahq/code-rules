---
/** @fileoverview Renders baseline-aligned brand links with a temporary outlined Assemble logo in development. */
const previewAssemble = import.meta.env.DEV;
---
<div class="cr-brand" aria-label="Fabrica / Code Rules">
  <a class:list={['brand-parent', { 'with-assemble': previewAssemble }]} href="https://fabricahq.com">
    {previewAssemble && <svg class="assemble-mark" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 1.75 21.25 7.1V17L12 22.35 2.75 17V7.1Z" fill="#fff" />
      <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 1.75 21.25 7.1V17L12 22.35 2.75 17V7.1Z" />
        <path d="m2.75 7.1 9.25 5.35 9.25-5.35M12 12.45v9.9" />
        <path d="m7.375 4.425 9.25 5.35M7.375 9.775v9.9M12 17.4l9.25-5.35" />
      </g>
    </svg>}
    <span>Fabrica</span>
  </a>
  <span class="brand-separator" aria-hidden="true">/</span>
  <a class="brand-product" href="/" aria-label="Code Rules home">Code Rules</a>
</div>
<style>
  .cr-brand { gap: .5rem; align-items: baseline; }
  .cr-brand a { color: inherit; text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .cr-brand .brand-parent { position: relative; gap: .4rem; color: var(--sl-color-gray-3); font-size: .85em; font-weight: 400; }
  .cr-brand .brand-parent.with-assemble { padding-left: 19px; }
  .assemble-mark { position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; overflow: visible; }
  .brand-separator { color: var(--cr-muted); font-weight: 400; }
  .cr-brand a:hover { text-decoration: none; }
  .cr-brand .brand-product:hover { color: #ffffff; }
  :global(:root[data-theme="light"]) .cr-brand .brand-product:hover { color: #000000; }
  .cr-brand .brand-parent:hover { color: var(--cr-ink); text-decoration: none; }
</style>
