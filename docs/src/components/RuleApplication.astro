---
/** @fileoverview Shows an illustrative coding-agent handoff linking applied rules to concrete changes and test evidence. */
const changes = [
  { rule: 'Verify retry limits', change: 'Stopped requests after the third attempt.', file: 'retry.ts' },
  { rule: 'Preserve error context', change: 'Kept the original failure for the caller.', file: 'retry.ts' },
  { rule: 'Test failure paths', change: 'Added coverage for exhausted retries.', file: 'retry.test.ts' },
];
---
<div class="application" aria-label="Illustrative agent handoff">
  <div class="report-heading"><span class="agent-icon" aria-hidden="true">✳︎</span><span>Agent handoff</span><span class="ready">Ready for review</span></div>
  <div class="report-body">
    <h3>Retries now follow your project’s rules.</h3>
    <p class="summary">I updated the implementation and verified the failure cases.</p>
    <ul>
      {changes.map(({ rule, change, file }) => <li><span class="check" aria-hidden="true">✓</span><div><strong>{rule}</strong><p>{change}</p><code>{file}</code></div></li>)}
    </ul>
    <div class="evidence"><span><strong>2</strong> files changed</span><span><strong>3</strong> rules applied</span><span class="tests"><span aria-hidden="true">✓</span> Tests passing</span></div>
  </div>
  <div class="report-caption">Example report from your coding agent.</div>
</div>
<style>
  .application { min-width: 0; border: 1px solid var(--cr-line); border-radius: 16px; overflow: hidden; background: var(--cr-paper); --report-green: #80c6a4; }
  :global([data-theme='light']) .application { --report-green: #287253; }
  .report-heading { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--cr-faint); background: var(--cr-surface); font-size: .8rem; font-weight: 500; }
  .agent-icon { font-size: 1.15rem; color: var(--report-green); }
  .ready { margin-left: auto; padding: .3rem .55rem; border-radius: 5px; background: color-mix(in srgb, var(--report-green) 10%, transparent); color: var(--report-green); font-size: .65rem; }
  .report-body { padding: 1.4rem; }
  h3 { margin: 0; color: var(--cr-ink); font-size: 1.1rem; font-weight: 550; letter-spacing: -.025em; }
  .summary { margin: .6rem 0 1.25rem; color: var(--cr-muted); font-size: .85rem; line-height: 1.65; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: flex; gap: .8rem; padding: .95rem 0; border-top: 1px solid var(--cr-faint); }
  .check { color: var(--report-green); }
  li strong { font-size: .85rem; font-weight: 550; }
  li p { margin: .3rem 0 .5rem; color: var(--cr-muted); font-size: .8rem; line-height: 1.6; }
  code { padding: .2rem .4rem; border: 0; border-radius: 4px; background: var(--cr-surface); color: var(--cr-muted); font: .65rem var(--cr-font-mono); }
  .evidence { display: flex; flex-wrap: wrap; gap: .65rem 1.15rem; margin-top: .75rem; padding-top: 1.1rem; border-top: 1px solid var(--cr-faint); font-size: .7rem; color: var(--cr-muted); }
  .evidence strong { color: var(--cr-ink); font-weight: 550; }
  .tests { color: var(--report-green); }
  .report-caption { padding: .85rem 1.4rem; border-top: 1px solid var(--cr-faint); color: var(--cr-muted); font-size: .65rem; }
</style>
