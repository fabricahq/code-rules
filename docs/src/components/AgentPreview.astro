---
/** @fileoverview Shows two illustrative, controllable agent sessions using adopted rules to write and review code. */
import AgentSession from './AgentSession.astro';
const rule = 'local:practices/testing/verify-retry-limits';
const reading = {
  title: 'Read the adopted rules', kind: 'READ', file: '.code-rules/generated/RULES.md',
  note: 'This task changes retry behavior. Open the testing group, then read the complete retry-limit rule.',
  code: 'practices/testing\n  Verify retry limits\n  When to read: bounded retry behavior', lang: 'text' as const,
};
const write = [reading, {
  title: 'Turn guidance into a plan', kind: 'RULE', file: rule,
  note: 'The rule requires a failing-request test. I’ll bound the loop and verify both the call count and the final error.',
  code: 'For a limit of three attempts:\n- Make every attempt fail.\n- Assert exactly three calls.\n- Assert the documented failure is returned.', lang: 'md' as const,
}, {
  title: 'Write the implementation', kind: 'EDIT', file: 'src/retry.ts · excerpt',
  note: 'Count attempts from one. Return on success; preserve the final failure at the limit.',
  code: 'for (let attempt = 1; attempt <= limit; attempt++) {\n  try {\n    return await request();\n  } catch (error) {\n    if (attempt === limit) throw error;\n  }\n}', lang: 'ts' as const,
}, {
  title: 'Add the required regression test', kind: 'EDIT', file: 'src/retry.test.ts · excerpt',
  note: 'Make every request fail, then assert the exact limit and the returned error.',
  code: "const request = mock(() => Promise.reject(offline));\n\nawait expect(retry(request, 3)).rejects.toBe(offline);\nexpect(request).toHaveBeenCalledTimes(3);", lang: 'ts' as const,
}, {
  title: 'Verify the implementation', kind: 'TEST', file: '$ bun test src/retry.test.ts',
  note: 'The helper and its tests are ready. The rule informed the implementation before review.',
  code: '✓ stops after three failed attempts\n✓ returns the final request error\n\n2 passed · 0 failed', lang: 'text' as const,
}];
const review = [reading, {
  title: 'Inspect the implementation', kind: 'READ', file: 'src/retry.ts · excerpt',
  note: 'I’ve read the full retry-limit rule. This loop starts at zero and includes the limit, which permits an extra request.',
  code: 'for (let attempt = 0; attempt <= limit; attempt++) {\n  try {\n    return await request();\n  } catch (error) {\n    if (attempt === limit) throw error;\n  }\n}', lang: 'ts' as const,
}, {
  title: 'Reproduce the finding', kind: 'FAIL', file: '$ bun test src/retry.test.ts',
  note: 'Evidence for the retry-limit finding: with a limit of three and every request failing, the helper makes four calls.',
  code: '✕ stops after three failed attempts\n\nExpected call count: 3\nReceived call count: 4', lang: 'text' as const,
}, {
  title: 'Fix the off-by-one error', kind: 'PATCH', file: 'src/retry.ts',
  note: 'Start at one, preserving the existing final-error check. Keep the failing test as a regression test.',
  code: '- for (let attempt = 0; attempt <= limit; attempt++) {\n+ for (let attempt = 1; attempt <= limit; attempt++) {', lang: 'diff' as const,
}, {
  title: 'Verify the fix', kind: 'TEST', file: '$ bun test src/retry.test.ts',
  note: 'Fixed the extra request and verified the final error is still returned. Finding resolved with test evidence.',
  code: '✓ stops after three failed attempts\n✓ returns the final request error\n\n2 passed · 0 failed', lang: 'text' as const,
}];
---
<figure id="agent-preview" aria-label="Illustrative agent sessions" class="agent-preview">
  <div class="sessions">
    <AgentSession title="Write with rules" number="01" task="Add a retry helper. Stop after three attempts." steps={write} />
    <AgentSession title="Review and fix" number="02" task="Review the retry helper against our rules. Fix any issues." steps={review} />
  </div>
  <figcaption>Illustrative agent sessions. Code Rules supplies the rules; your agent reads them, edits code, and runs tests.</figcaption>
</figure>
<style>
  .agent-preview { margin: 0; scroll-margin-top: 5rem; }
  .sessions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  figcaption { color: var(--cr-muted); font-size: .75rem; line-height: 1.6; text-align: center; margin-top: 1rem; }
  @media (max-width: 799px) { .sessions { grid-template-columns: minmax(0, 1fr); } }
</style>
