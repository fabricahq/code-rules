---
/** @fileoverview Shows two illustrative, controllable agent sessions using adopted rules to write and review code. */
import AgentSession from './AgentSession.astro';
const readRule = {
  title: 'Read your rule', kind: 'RULE', file: 'Keep secrets out of logs',
  note: 'First, I’ll read your logging rule.',
  code: 'Never write secrets to logs.', lang: 'text' as const,
};
const write = [readRule, {
  title: 'Apply it', kind: 'EDIT', file: 'sign-in.ts · excerpt',
  note: 'I’m writing the logging code to follow your rule: include user IDs, never passwords.',
  code: 'log.info({ userId }, "Signed in");', lang: 'ts' as const,
}, {
  title: 'Verify the result', kind: 'TEST', file: 'bun test',
  note: 'Verified: no passwords in the logs.',
  code: '✓ Sign-ins logged · passwords excluded', lang: 'text' as const,
}];
const review = [{
  title: 'Inspect the code', kind: 'READ', file: 'sign-in.ts · excerpt',
  note: 'This sign-in handler logs credentials.',
  code: 'log.info({ userId, password });', lang: 'ts' as const,
}, {
  ...readRule, note: 'I’ll check your rule for logging secrets.',
}, {
  title: 'Find and fix', kind: 'PATCH', file: 'sign-in.ts · excerpt',
  note: 'Logging the password violates this rule. I’ll remove it.',
  code: '- log.info({ userId, password });\n+ log.info({ userId });', lang: 'diff' as const,
}, {
  title: 'Verify the fix', kind: 'TEST', file: 'bun test',
  note: "Fixed. I've also added a regression test for ongoing validation.",
  code: '✓ Password never logged · test passed', lang: 'text' as const,
}];
---
<figure id="agent-preview" class="mx-auto my-0 max-w-[49rem] scroll-mt-20" aria-label="Illustrative agent sessions">
  <agent-demo class="block">
    <div class="flex justify-center gap-[.4rem] mb-[1.1rem]" role="tablist" aria-label="Choose an agent session" hidden data-tabs>
      <button class="min-h-11 py-[.65rem] px-5 border border-transparent rounded-lg bg-transparent text-muted font-sans text-[.85rem] leading-[normal] font-medium cursor-pointer aria-selected:bg-demo-tool aria-selected:text-demo-blue aria-selected:border-demo-border data-[tab=review]:aria-selected:text-demo-purple [@media(max-width:540px)]:text-xs [@media(max-width:540px)]:px-3 [&_span]:mr-[.45rem]" type="button" role="tab" id="tab-write" aria-controls="session-write" aria-selected="true" tabindex="0" data-tab="write"><span aria-hidden="true">✳︎</span> Write with rules</button>
      <button class="min-h-11 py-[.65rem] px-5 border border-transparent rounded-lg bg-transparent text-muted font-sans text-[.85rem] leading-[normal] font-medium cursor-pointer aria-selected:bg-demo-tool aria-selected:text-demo-blue aria-selected:border-demo-border data-[tab=review]:aria-selected:text-demo-purple [@media(max-width:540px)]:text-xs [@media(max-width:540px)]:px-3 [&_span]:mr-[.45rem]" type="button" role="tab" id="tab-review" aria-controls="session-review" aria-selected="false" tabindex="-1" data-tab="review"><svg class="inline-block mr-[.45rem] align-[-.2em]" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg> Review and fix</button>
    </div>
    <div class="relative border border-demo-border rounded-[14px] overflow-hidden bg-demo-panel shadow-[0_20px_65px_-30px_#547cba55,0_2px_8px_#162a4910]" data-session-window>
      <div class="flex items-center gap-4 py-[.9rem] px-5 border-b border-demo-border bg-demo-bar text-demo-ink font-sans text-[.8rem] leading-[normal] [@media(max-width:540px)]:px-[.85rem] [@media(max-width:540px)]:text-[.65rem]"><span class="grid place-items-center size-[30px] rounded-lg text-demo-purple bg-[color-mix(in_srgb,var(--demo-purple)_12%,transparent)] text-[1.2rem]" aria-hidden="true">✳︎</span><span class="font-[550]">Your coding agent <span class="block mt-[.2rem] text-demo-muted font-normal font-mono text-[.65rem] leading-[normal]">acme-checkout</span></span><span class="ml-auto text-[.6rem] tracking-[.12em] text-demo-muted [@media(max-width:540px)]:text-[.5rem]">EXAMPLE SESSION</span></div>
      <div class="relative">
        <AgentSession id="write" title="Write with rules" task="Add logging for successful sign-ins." steps={write} selected />
        <AgentSession id="review" title="Review and fix" task="Review our sign-in logging. Fix any issues." steps={review} />
        <div class="absolute inset-0 grid place-items-center bg-[linear-gradient(transparent_15%,var(--demo-panel)_55%)]" hidden data-preview-overlay>
          <button type="button" class="inline-flex items-center gap-[.65rem] min-h-[52px] py-3 px-[1.4rem] border border-demo-border rounded-full bg-demo-panel text-demo-ink shadow-[0_4px_18px_#162a4912,0_1px_3px_#162a4910] cursor-pointer font-sans text-[.85rem] font-medium leading-[normal] hover:border-demo-blue hover:bg-demo-tool focus-visible:outline-2 focus-visible:outline-demo-blue focus-visible:outline-offset-4" data-start aria-label="Play example session">
            <span class="grid place-items-center text-demo-blue [&_svg]:size-5"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="m8 4 12 8-12 8Z" /></svg></span>
            <span>Play example</span>
          </button>
        </div>
      </div>
    </div>
    <div class="playback flex flex-wrap items-center justify-between gap-x-4 gap-y-[.6rem] mt-[.85rem] [@media(max-width:540px)]:gap-2" hidden data-controls>
      <div class="flex flex-wrap justify-end gap-2 ml-auto [@media(max-width:540px)]:w-full">
        <button type="button" class="inline-flex items-center justify-center gap-[.3rem] min-h-8 py-1 px-2 bg-transparent border border-demo-border rounded-badge text-demo-muted cursor-pointer font-sans text-[.65rem] leading-[normal] disabled:cursor-default hover:not-disabled:bg-demo-tool hover:not-disabled:border-demo-blue [&_svg]:size-[13px] [&_svg]:shrink-0 min-w-16" data-play>
          <svg class="play-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="m8 5 11 7-11 7Z" /></svg>
          <svg class="pause-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 5v14M16 5v14" /></svg>
          <span data-play-label>Play</span>
        </button>
        <button type="button" class="inline-flex items-center justify-center gap-[.3rem] min-h-8 py-1 px-2 bg-transparent border border-demo-border rounded-badge text-demo-muted cursor-pointer font-sans text-[.65rem] leading-[normal] disabled:cursor-default hover:not-disabled:bg-demo-tool hover:not-disabled:border-demo-blue [&_svg]:size-[13px] [&_svg]:shrink-0" data-replay><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10a9 9 0 1 1 2 8M3 4v6h6" /></svg>Replay</button>
        <button type="button" class="inline-flex items-center justify-center gap-[.3rem] min-h-8 py-1 px-2 bg-transparent border border-demo-border rounded-badge text-demo-muted cursor-pointer font-sans text-[.65rem] leading-[normal] disabled:cursor-default hover:not-disabled:bg-demo-tool hover:not-disabled:border-demo-blue [&_svg]:size-[13px] [&_svg]:shrink-0" data-finish><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" /></svg>Show full session</button>
      </div>
    </div>
    <noscript><p class="text-muted text-xs leading-[1.6] text-center mt-4">Enable JavaScript to play the demos or switch sessions. The complete writing session is shown above.</p></noscript>
  </agent-demo>
</figure>
<script>
  import './agent-demo';
</script>
<style>
  agent-demo {
    --demo-ink: #e1e9f5; --demo-muted: #99aac2; --demo-border: #2c3a50;
    --demo-panel: #121c2b; --demo-tool: #172336; --demo-bar: #1b293e;
    --demo-blue: #7fc5ff; --demo-purple: #c5a4ff; --demo-green: #80d9b2;
    --demo-red: #ff9c9d; --demo-amber: #eac483;
  }
  :global([data-theme='light']) agent-demo {
    --demo-ink: #23324a; --demo-muted: #60718b; --demo-border: #dce4ef;
    --demo-panel: #fcfdff; --demo-tool: #f4f7fc; --demo-bar: #eef3fb;
    --demo-blue: #216bb0; --demo-purple: #7850ae; --demo-green: #267553;
    --demo-red: #af3c47; --demo-amber: #966022;
  }

  /* Playback state changes which controls are visible, not their layout. */
  [data-preview] .playback [data-play], [data-preview] .playback [data-replay] { display: none; }
  .pause-icon { display: none; }
  [data-playing] .pause-icon { display: block; }
  [data-playing] .play-icon { display: none; }
  [hidden] { display: none !important; }

</style>
