---
/** @fileoverview Renders the Starlight footer followed by Fabrica branding and a short sentiment. */

import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
---
<DefaultFooter />
<div class="cr-footer">
  <div class="cr-footer-identity">
    <span><a href="https://fabricahq.com">Fabrica</a> <span aria-hidden="true">/</span> Code Rules</span>
    <p class="cr-footer-sentiment">Built with care. And opinions about code.</p>
  </div>
</div>
