---
/** @fileoverview Presents an icon-only Fabrica-style theme menu while Starlight owns theme application and persistence. */
import DefaultThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { Icon } from '@astrojs/starlight/components';
const choices = [
  { value: 'light', label: 'Light', icon: 'sun' },
  { value: 'dark', label: 'Dark', icon: 'moon' },
  { value: 'auto', label: 'Auto', icon: 'desktop' },
] as const;
---
<fabrica-theme-menu>
  <div hidden><DefaultThemeSelect /></div>
  <details hidden>
    <summary aria-label="Color theme: Auto" title="Color theme: Auto">
      {choices.map(({ value, icon }) => <span data-theme-icon={value} hidden={value !== 'auto'}><Icon name={icon} size="19px" /></span>)}
    </summary>
    <div class="theme-options" role="group" aria-label="Color theme">
      {choices.map(({ value, label, icon }) => <button type="button" data-theme-choice={value} aria-pressed={value === 'auto'}>
        <Icon name={icon} size="18px" /><span>{label}</span><Icon name="approve-check" size="14px" class="theme-check" />
      </button>)}
    </div>
  </details>
</fabrica-theme-menu>
<script>
  /** Adapts menu buttons to Starlight's native select and synchronizes desktop and mobile pickers. */
  class FabricaThemeMenu extends HTMLElement {
    private events: AbortController | undefined;

    async connectedCallback() {
      await customElements.whenDefined('starlight-theme-select');
      if (!this.isConnected || this.events) return;
      this.events = new AbortController();
      const { signal } = this.events;
      const details = this.querySelector('details');
      const trigger = this.querySelector('summary');
      const select = this.querySelector('select');
      if (!details || !trigger || !select) return;

      const close = (restoreFocus = false) => {
        details.open = false;
        if (restoreFocus) trigger.focus();
      };
      const sync = () => {
        const value = select.value;
        const label = `Color theme: ${select.selectedOptions[0]?.textContent ?? 'Auto'}`;
        trigger.setAttribute('aria-label', label);
        trigger.title = label;
        this.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach((icon) => {
          icon.hidden = icon.dataset.themeIcon !== value;
        });
        this.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.themeChoice === value));
        });
      };
      this.addEventListener('click', (event) => {
        const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-theme-choice]') : null;
        if (!button) return;
        select.value = button.dataset.themeChoice ?? 'auto';
        // Let Starlight update the document, storage, and every native picker first.
        select.dispatchEvent(new Event('change', { bubbles: true }));
        close(true);
      }, { signal });
      document.addEventListener('change', (event) => {
        if (event.target instanceof HTMLSelectElement && event.target.closest('starlight-theme-select')) sync();
      }, { signal });
      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !this.contains(event.target)) close();
      }, { signal });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !details.open) return;
        event.preventDefault();
        close(true);
      }, { signal });
      this.addEventListener('focusout', (event) => {
        if (!(event.relatedTarget instanceof Node) || !this.contains(event.relatedTarget)) close();
      }, { signal });
      sync();
      details.hidden = false;
    }

    disconnectedCallback() {
      this.events?.abort();
      this.events = undefined;
    }
  }
  if (!customElements.get('fabrica-theme-menu')) customElements.define('fabrica-theme-menu', FabricaThemeMenu);
</script>
<style>
  fabrica-theme-menu { display: block; flex-shrink: 0; }
  details { position: relative; }
  [hidden] { display: none !important; }
  summary { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; list-style: none; cursor: pointer; color: var(--cr-muted); transition: background-color 160ms ease, color 160ms ease; }
  summary::-webkit-details-marker { display: none; }
  summary > span { display: flex; }
  summary:hover, details[open] summary { background: var(--cr-surface); color: var(--cr-ink); }
  .theme-options { position: absolute; right: 0; top: calc(100% + 8px); z-index: 20; display: grid; width: 176px; gap: 4px; padding: 6px; border: 1px solid var(--cr-line); border-radius: 12px; background: var(--cr-paper); box-shadow: 0 10px 15px -3px #0000001a, 0 4px 6px -4px #0000001a; }
  :global(.mobile-preferences) .theme-options { top: auto; bottom: calc(100% + 8px); }
  button { display: flex; align-items: center; gap: 12px; min-height: 44px; width: 100%; padding: 0 12px; border: 1px solid transparent; border-radius: 8px; background: transparent; color: var(--cr-muted); font: 400 .875rem var(--sl-font); text-align: left; cursor: pointer; transition: background-color 160ms ease, color 160ms ease; }
  button:hover { background: var(--cr-surface); color: var(--cr-ink); }
  button[aria-pressed='true'] { border-color: var(--cr-line); background: var(--cr-paper); color: var(--cr-ink); font-weight: 500; }
  .theme-check { margin-left: auto; opacity: 0; }
  button[aria-pressed='true'] .theme-check { opacity: 1; }
  summary:focus-visible, button:focus-visible { outline: 2px solid var(--cr-ink); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { summary, button { transition: none; } }
</style>
