  {
    "id": "configuration-exceptions",
    "operation": "configuration",
    "input": "{\"schemaVersion\": 1, \"sources\": {\"team\": {\"repository\": \"https://github.com/fixture/team.git\", \"ref\": \"v1.2.3\", \"groups\": [\"techs/go\"], \"exclude\": {\"techs/go/a\": \" unused \"}, \"replace\": {\"techs/go/b\": {\"file\": \"local/go/b.md\", \"reason\": \"team policy\"}}}}}",
    "location": "configuration",
    "expected": {
      "ok": true,
      "value": {
        "sources": [
          {
            "name": "team",
            "repository": "https://github.com/fixture/team.git",
            "ref": "v1.2.3",
            "groups": [
              "techs/go"
            ],
            "exclude": {
              "techs/go/a": " unused "
            },
            "replace": {
              "techs/go/b": {
                "file": "local/go/b.md",
                "reason": "team policy"
              }
            },
            "parsedRef": {
              "kind": "tag",
              "name": "refs/tags/v1.2.3"
            }
          }
        ]
      }
    }
  },
