{
  "name": "@fabricahq/code-rules",
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "docs:dev": "bun run --cwd docs dev",
    "docs:check": "bun run --cwd docs check",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run docs:check && bun run docs:build && bun run docs:links",
    "docs:links": "bun run --cwd docs links",
    "test": "bun test src _tools/*.test.ts docs/_tools/*.test.ts",
    "typecheck": "tsc --project tsconfig.json",
    "builds:example": "bun tests/manual/builds.ts",
    "format:check": "prettier --single-quote --check src _tools/*.ts docs/_tools/*.ts tests/**/*.ts eslint.config.mjs",
    "lint": "eslint .",
    "imports:example": "bun tests/manual/imports.ts",
    "build": "bun _tools/package.ts",
    "prepack": "bun run build",
    "test:package": "bun test tests/package/installed.test.ts"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "semver": "^7.8.5",
    "spdx-expression-parse": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/mdast": "^4.0.4",
    "@types/semver": "^7.8.0",
    "@types/spdx-expression-parse": "^4.0.0",
    "@typescript-eslint/parser": "^8.70.0",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.3.9",
    "prettier": "^3.9.6",
    "typescript": "6.0.3"
  },
  "version": "0.1.0-rc.1",
  "description": "Manage versioned engineering rules for your codebase.",
  "license": "UNLICENSED",
  "bin": {
    "code-rules": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabricahq/code-rules.git"
  },
  "homepage": "https://github.com/fabricahq/code-rules",
  "bugs": {
    "url": "https://github.com/fabricahq/code-rules/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
