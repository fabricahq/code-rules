{
  "name": "code-rules",
  "private": true,
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "docs:dev": "bun run --cwd docs dev",
    "docs:check": "bun run --cwd docs check",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run docs:check && bun run docs:build && bun run docs:links",
    "docs:links": "python3 _tools/check-doc-links.py",
    "test": "bun test src",
    "typecheck": "tsc --project tsconfig.json",
    "builds:example": "bun _tools/builds-example.ts",
    "format:check": "prettier --single-quote --check src _tools/builds-example.ts"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/mdast": "^4.0.4",
    "prettier": "^3.9.6",
    "typescript": "6.0.3"
  }
}
